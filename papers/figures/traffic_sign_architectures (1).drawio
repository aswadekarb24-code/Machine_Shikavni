        </mxCell>
        <mxCell id="resnet18-37" value="&lt;b&gt;Key points for viva&lt;/b&gt;&lt;br&gt;&amp;bull; The block learns a residual F(x) and outputs F(x) + x, so gradients flow through the skip path and deep nets train easily.&lt;br&gt;&amp;bull; 4 stages (64 &amp;rarr; 128 &amp;rarr; 256 &amp;rarr; 512 channels); each stage after the first halves the resolution (stride 2) and uses a 1&amp;times;1 conv on the skip path to match shapes.&lt;br&gt;&amp;bull; 8 BasicBlocks &amp;times; 2 convs + stem conv + FC = 18 weight layers &amp;middot; &amp;asymp; 11.2 M parameters." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1100" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
